{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeDesk",
  "version": "0.2.0",
  "identifier": "com.mnpue.timedesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NjA5ODQ5QThBMzMxNDAKUldSQU1hT29TWmhnU0NaRm4rMTNyd1RQREtiNEFnU3NveG13YWowYmpEbUhkRUllVEFzZVBWMmkK",
      "endpoints": [
        "https://github.com/NoemiPuerto/TimeDesk/releases/latest/download/latest.json"
      ]
    }
  }
}
